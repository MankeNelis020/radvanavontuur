# Rad van Avontuur — voorbeeldomgeving
# Kopieer naar .env.local. Zet geen echte sleutels in de repository.

# --- Supabase (optioneel account en blijvende opslag) ---
# Publieke URL en publishable key mogen naar de browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alleen server. Nooit NEXT_PUBLIC_ van maken.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Places en Routes (server) ---
# Zonder sleutel gebruikt de app alleen de eigen catalogus en toont ze dat eerlijk.
GOOGLE_MAPS_API_KEY=

# --- Google Sheets-beheer (server) ---
# JSON van het serviceaccount, als één regel of base64.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
# Vereist om de synchronisatie-route te mogen aanroepen.
ADMIN_SYNC_TOKEN=

# --- Weer ---
# open-meteo (standaard, live) | fixture | unavailable
# fixture weigert in productie, tenzij ALLOW_FIXTURE_PROVIDERS=true (alleen tests).
WEATHER_PROVIDER=open-meteo
ALLOW_FIXTURE_PROVIDERS=

# --- Advertenties ---
# Blijft uit tot expliciete goedkeuring. De component toont dan alleen een placeholder.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=

# --- Affiliate ---
# Leeg laten. Ticketlinks komen uit de aparte affiliate-tabel, nooit uit de aanbevelingsmotor.
AFFILIATE_ENABLED=false
